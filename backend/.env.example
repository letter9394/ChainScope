CHAIN_SCOPE_ENV=development
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_DEMO_API_KEY=
BINANCE_MARKET_URL=https://data-api.binance.vision
BINANCE_FUTURES_URL=https://fapi.binance.com
FEAR_GREED_URL=https://api.alternative.me/fng/
GOLD_API_URL=https://api.gold-api.com/price/XAU
MARKET_CACHE_SECONDS=60
GOLD_CACHE_SECONDS=15
HISTORY_CACHE_SECONDS=300
CANDLE_CACHE_SECONDS=8
DERIVATIVES_CACHE_SECONDS=10
DATABASE_URL=
DATABASE_PATH=.local/chainscope.db
SESSION_SECRET=replace-with-a-long-random-value
BACKGROUND_ALERTS_ENABLED=true
ALERT_CHECK_SECONDS=60
PUBLIC_APP_URL=http://localhost:3100
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURITY=ssl
SMTP_TIMEOUT_SECONDS=15
NEWS_RSS_URL=https://www.coindesk.com/arc/outboundfeeds/rss/
NEWS_CACHE_SECONDS=300
GOOGLE_TRANSLATION_API_URL=https://translate.googleapis.com/translate_a/single
TRANSLATION_API_URL=https://api.mymemory.translated.net/get
TRANSLATION_CACHE_SECONDS=86400

# Optional OpenAI-compatible provider. Leave empty to use the rule-based fallback.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
